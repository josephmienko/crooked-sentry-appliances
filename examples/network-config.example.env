# Network Configuration Template for Crooked Sentry Appliances
# Copy this file to my-network-config.env and fill in YOUR values
# Do NOT commit this file with real values to git

=== PRIMARY APPLIANCE (Home Assistant OS / Raspberry Pi) ===

HA_RPI_IP=192.168.1.10
HA_RPI_HOSTNAME=ha-rpi
HA_RPI_DOMAIN=local
HA_RPI_SSH_PORT=22
HA_RPI_SSH_USER=root

=== ANALYTICS APPLIANCE (Frigate / OptiPlex) ===

OPTIPLEX_IP=192.168.1.20
OPTIPLEX_HOSTNAME=optiplex-frigate
OPTIPLEX_DOMAIN=local
OPTIPLEX_SSH_PORT=22
OPTIPLEX_SSH_USER=your_linux_username

=== MQTT BROKER (runs on Raspberry Pi) ===

MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=homeassistant
# MQTT_PASSWORD= (keep in secrets.env, not this file)

# Frigate MQTT User
MQTT_FRIGATE_USER=frigate
# MQTT_FRIGATE_PASSWORD= (keep in secrets.env, not this file)

=== FRIGATE SERVICE ===

FRIGATE_HOST=192.168.1.20
FRIGATE_API_PORT=5000
FRIGATE_RTSP_PORT=9001

=== SYSTEM ===

TIMEZONE=America/Chicago
# Update to your timezone if different

NETWORK_CIDR=192.168.1.0/24
# The network subnet your appliances are on
# If your network is different (e.g., 10.x.x.x), update accordingly

DNS_SERVER=192.168.1.1
# Usually your router's IP; update if using different DNS

=== CREDENTIALS (keep in separate secrets.env file) ===

# Do NOT fill these below. Create a secrets.env file instead:
#
# cat > secrets.env << 'EOF'
# HA_ADMIN_PASSWORD=your_actual_password
# MQTT_PASSWORD=your_mqtt_password
# MQTT_FRIGATE_PASSWORD=your_frigate_password
# FRIGATE_RTSP_PASSWORD=your_rtsp_password
# EOF
#
# chmod 600 secrets.env
# gitignore: secrets.env
