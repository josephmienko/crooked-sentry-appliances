# Frigate Docker Compose Environment Template
# Copy this file to .env and fill in your actual values
# Do NOT commit actual passwords to git

# MQTT Configuration
# From Phase 1 & 4 setup
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=frigate
MQTT_PASSWORD=your_secure_frigate_mqtt_password_here

# Frigate API & RTSP Settings
FRIGATE_API_PORT=5000
FRIGATE_RTSP_PORT=9001
FRIGATE_RTSP_PASSWORD=rtsp_stream_password

# System Timezone
# Use standard timezone strings (America/Chicago, Europe/London, etc.)
TIMEZONE=America/Chicago

# Optional: Advanced Docker Resource Limits
# Uncomment and adjust if needed for CPU/memory constrained systems
# DOCKER_CPU_LIMIT=2
# DOCKER_MEMORY_LIMIT=2g

# Optional: GPU Support
# Leave commented unless your OptiPlex has Intel/AMD GPU
# Uncomment one of:
# LIBVA_DRIVER_NAME=iHD        # Intel GPU support
# LIBVA_DRIVER_NAME=radeonsi   # AMD GPU support
