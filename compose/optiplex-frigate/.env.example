# Frigate Docker Compose Environment Template
# 
# CRITICAL SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in ALL required values (marked REQUIRED below)
# 3. DO NOT commit .env to git (already ignored by .gitignore)
# 4. Run validation: docker compose --env-file .env.example config
#    This will FAIL with clear error messages if required values are empty
# 5. Once .env is complete with real values, run: docker compose up -d
#
# SECURITY NOTE:
# - MQTT_PASSWORD and FRIGATE_RTSP_PASSWORD are critical.
# - Do NOT use weak passwords or defaults.
# - Do NOT share .env in logs, issues, or pull requests.
# - For password rotation, update .env and restart: docker compose restart
#
# Required Variables Syntax:
# In docker-compose.yml, required secrets use: ${VAR_NAME:?ERROR: message}
# This syntax ensures docker compose fails immediately if VAR_NAME is empty or missing.
# You will see an error like: "ERROR: Invalid interpolation format for..."

# MQTT Broker Connection (From Phase 4 setup)
# These values connect Frigate to the Mosquitto broker running on HA appliance
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=frigate
# REQUIRED: Set to actual MQTT password (generated in Phase 4)
# Syntax: ${MQTT_PASSWORD:?ERROR: MQTT_PASSWORD is required in .env}
# If empty, docker compose will FAIL with clear error message
# Example (do NOT use this in production): MQTT_PASSWORD=secure_mqtt_pass_123
MQTT_PASSWORD=

# Frigate Service Configuration
# HTTP API port (exposed to HA appliance for integration)
FRIGATE_API_PORT=5000
# RTSP proxy port (streams from IP cameras to Frigate)
FRIGATE_RTSP_PORT=8554
# REQUIRED: Set to actual RTSP password for stream proxy
# Syntax: ${FRIGATE_RTSP_PASSWORD:?ERROR: FRIGATE_RTSP_PASSWORD is required in .env}
# If empty, docker compose will FAIL with clear error message
# Note: This is the password cameras use to connect to Frigate's proxy, not HA credentials
# Example (do NOT use this in production): FRIGATE_RTSP_PASSWORD=secure_rtsp_pass_456
FRIGATE_RTSP_PASSWORD=

# System Timezone
# Use IANA timezone strings: America/Chicago, Europe/London, UTC, etc.
# Affects Frigate timestamps and recording schedules
TIMEZONE=America/Chicago

# Optional: Advanced Docker Resource Limits
# Uncomment and adjust if your OptiPlex has CPU/memory constraints
# If your system has <4GB RAM or <2 CPU cores, consider setting these
# DOCKER_CPU_LIMIT=2
# DOCKER_MEMORY_LIMIT=2g

# Optional: GPU Support
# Leave commented unless your OptiPlex has Intel/AMD integrated GPU
# Intel GPU (most OptiPlex 3080 machines):
# LIBVA_DRIVER_NAME=iHD
# 
# AMD GPU (if you have Radeon):
# LIBVA_DRIVER_NAME=radeonsi

# Storage Configuration
# Path where Frigate will store recordings, cache, and config
# This should be on a large, stable partition (500GB+ recommended)
# Pre-create this directory and verify permissions before deploying:
#   mkdir -p ./frigate/{config,recordings,cache}
#   chmod 755 ./frigate
FRIGATE_CONFIG_DIR=./frigate/config
FRIGATE_RECORDINGS_DIR=./frigate/recordings
FRIGATE_CACHE_DIR=./frigate/cache

